# Copy to .env and fill in. Never commit the real .env.

# --- Database (dedicated container, docker-compose.yml — NOT port 5432, that's
# the operational-intelligence project's own Postgres) ---
DATABASE_URL=postgres://work_agent:work_agent_dev_only@localhost:5433/work_agent

# --- Jira / Atlassian (read-only in Phase 1) ---
JIRA_BASE_URL=https://qed42-operations.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- GitHub ---
# Prefer the `gh` CLI's existing auth (already set up on this machine with
# real org access) over a raw token where possible. If you do set a token,
# it needs org repo access — the GitHub MCP plugin's PAT does NOT have that.
GITHUB_TOKEN=

# --- Slack: reading (only if you want the scheduler to gather Slack data
# unattended — not needed if Slack activity only gets gathered while
# actively chatting with a live Claude Code session, which already has
# read access). Requires a USER token (xoxp-), not a bot token — Slack's
# search API only works with user tokens, and a bot can't see your DMs with
# other people anyway. Create a Slack App -> OAuth & Permissions -> "User
# Token Scopes" (NOT "Bot Token Scopes") -> add ONLY:
#   search:read.public search:read.private search:read.im search:read.mpim
#   channels:read groups:read im:read mpim:read users:read
# Deliberately do NOT add chat:write here — this token should be
# structurally incapable of sending anything.
# Install to workspace -> copy the "User OAuth Token".
SLACK_USER_TOKEN=
SLACK_USER_ID=

# --- Slack: sending (optional, off by default, not needed unless you
# explicitly want to enable communication.autoSendRoutine later). A
# SEPARATE, narrower bot token scoped to only chat:write — this one can
# never read your DMs or search anything, it can only post to channels
# it's invited into. Leave blank if you don't want automated sending at
# all (the recommended default).
SLACK_BOT_TOKEN=

WORK_AGENT_MODE=auto
