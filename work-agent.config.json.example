{
  "jira": {
    "myProjects": [],
    "ignoredKeys": []
  },
  "github": {
    "approvedRepos": [
      "your-org/your-repo"
    ],
    "repoMap": {
      "PROJ": "your-org/your-repo"
    },
    "repoLocalPaths": {
      "your-org/your-repo": "/absolute/path/to/your/local/clone"
    },
    "repoDefaultBranches": {
      "your-org/your-repo": "main"
    },
    "previewRecipes": {
      "your-org/your-repo": {
        "startCommand": [
          "npm",
          "run",
          "dev"
        ],
        "port": 3000,
        "readyPath": "/",
        "readyTimeoutMs": 120000,
        "env": {},
        "testLogin": {
          "emailSelector": "input[name=\"email\"]",
          "email": "test-user@example.com",
          "submitSelector": "text=Sign in (test)"
        }
      }
    },
    "backendSync": {
      "your-org/your-repo": {
        "command": [
          "/absolute/path/to/update-backend.sh"
        ],
        "timeoutMs": 900000,
        "onFailure": "warn",
        "description": "CMS backend (Docker)"
      }
    }
  },
  "slack": {
    "relevantChannels": []
  },
  "engineeringExecution": {
    "openPrAsDraft": true
  },
  "dashboard": {
    "terminalOs": "ubuntu"
  }
}
